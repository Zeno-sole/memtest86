#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -Wall -Wextra
export DEB_CXXFLAGS_MAINT_APPEND = -Wall -Wextra

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_install:
	dh_auto_install -- DESTDIR=$(CURDIR)/debian/memtest86

# Move translations to the standard share location (CMake already installs
# them under share/memtest86/translations, which is what the app expects).
override_dh_install:
	dh_install
